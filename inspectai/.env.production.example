NODE_ENV=production
APP_DOMAIN=app.example.com
FRONTEND_URL=https://app.example.com
APP_VERSION=1.0.0-rc.1
DATABASE_URL=postgresql://inspectai_runtime:REPLACE_PASSWORD@YOUR_HOST:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVICE_ROLE_KEY
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
ENABLE_AI_ASSISTANCE=false
ENABLE_PDF_EXTRACTION=false
ENABLE_MOMS_IMPORT=false
